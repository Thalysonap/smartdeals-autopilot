# Ambiente local (padrão): banco SQLite em data/smartdeals.db, autenticação local
# Produção: preencha as variáveis abaixo para usar Supabase/Postgres e Supabase Auth
NEXT_PUBLIC_APP_URL=http://localhost:3000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Obrigatório em produção para autorizar o Vercel Cron
CRON_SECRET=

# Opcional: credencial autorizada própria para a API do Mercado Livre
MERCADO_LIVRE_ACCESS_TOKEN=

# Ajustes de coleta (respeito a limites de acesso)
STORE_REQUEST_INTERVAL_MS=1500
WORKER_CONCURRENCY=3
WORKER_POLL_MS=5000

# Execução de testes de coleta real: RUN_LIVE_TESTS=1 npm test
RUN_LIVE_TESTS=0
